android_app {
    name: "WidevineProvision",

    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "vendor.xiaomi.hardware.mtdservice-V1.2-java",
    ],

    optimize: {
        enabled: false,
    },
}
