# Allow init to bind mount dsp file
allow init adsprpcd_file:file mounton;

# For mount /sys/kernel/debug/tracing
# to support tracefs if debugfs is disabled
allow init debugfs_tracing_debug:dir mounton;

set_prop(vendor_init, vendor_power_prop)

# Allow init to read and write to vendor_sysfs_graphics
allow init vendor_sysfs_graphics:dir search;
allow init vendor_sysfs_graphics:file rw_file_perms;

allow init same_process_hal_file:file execute;

# /proc/last_kmsg
allow init proc_last_kmsg:file r_file_perms;
allow init proc_last_kmsg:file setattr;

# Properties set by vendor init (vendor.prop, init.*.rc)
set_prop(vendor_init, vendor_fp_prop)
set_prop(vendor_init, mlipay_prop)

# Enable EAS from vendor.setup.power
allow vendor_init proc_sched:file w_file_perms;

# memlat governor creates its perf events with the writer's credentials,
# so init needs perf_event access when mem_latency is set from init.power.rc
allow vendor_init self:perf_event { open cpu kernel read write };
